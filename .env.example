# Absolute URL of the Aave app under test.
# Defaults to https://app.aave.com/ when unset.
BASE_URL=https://app.aave.com/

# URL of the test plan spreadsheet for AI tests generation
TEST_PLAN_SPREADSHEET=https://docs.google.com/spreadsheets/...

# JSON-RPC URL for Base Sepolia.
# Required only by tests that use the blockchain fixture.
# Add RPC_URL_<NETWORK> when a network is added under e2e/config/networks.ts.
RPC_URL_BASE_SEPOLIA=

# Private keys for the mocked wallets. The wallet signs in Node and broadcasts
# eth_sendTransaction to Base Sepolia. Never commit the real values.
# Wallet 1: 0x7b697Bf94E3fa3559Ee3fbc0389D942b7230Da54
WALLET1_PRIVATE_KEY=
# Wallet 2: 0xf9b4B50794393C4870956B73531AFC83CBc7436b
WALLET2_PRIVATE_KEY=
